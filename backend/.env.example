# ============================================
# AI ChatBot API - Environment Configuration
# ============================================
# Copy this file to .env and update values for your environment

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ============================================
# Frontend URL (CORS)
# ============================================
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# ============================================
# Database (Supabase PostgreSQL)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================
# Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ============================================
# Large Language Models
# ============================================
# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# Vector Database
# ============================================
# Supabase pgvector settings
SUPABASE_VECTOR_TABLE=document_chunks
SUPABASE_VECTOR_RPC=match_document_chunks
SUPABASE_VECTOR_CONTENT_COLUMN=content
SUPABASE_VECTOR_EMBEDDING_COLUMN=embedding
RAG_SCORE_THRESHOLD=0.7

# ============================================
# Web Scraping Configuration
# ============================================
SCRAPE_TIMEOUT=30000
MAX_CONCURRENT_SCRAPES=3
PUPPETEER_EXECUTABLE_PATH=

# ============================================
# Demo Mode (Development/Testing)
# ============================================
# Must be false for production-ready configuration
DEMO_MODE=false

# ============================================
# Monitoring & Error Tracking (Optional)
# ============================================
SENTRY_DSN=
LOG_TO_FILE=true
LOG_DIR=./logs

# ============================================
# Email & Scheduler (Daily Summaries)
# ============================================
ENABLE_DAILY_SUMMARY_SCHEDULER=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================
# PayPal Billing
# ============================================
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ============================================
# Auto Sync (Scheduled Retraining)
# ============================================
ENABLE_AUTO_SYNC_WORKER=false
AUTO_SYNC_CRON_SECRET=
AUTO_SYNC_BATCH_LIMIT=10
AUTO_SYNC_WORKER_BATCH=5
AUTO_SYNC_POLL_INTERVAL_MS=60000
AUTO_SYNC_DEFAULT_INTERVAL_HOURS=168
AUTO_SYNC_SITEMAP_INTERVAL_HOURS=168
AUTO_SYNC_URL_INTERVAL_HOURS=168
AUTO_SYNC_HELP_CENTER_INTERVAL_HOURS=168
AUTO_SYNC_RAW_TEXT_INTERVAL_HOURS=720
AUTO_SYNC_FILE_INTERVAL_HOURS=720
CONTENT_TEXT_MAX_CHARS=200000

# ============================================
# Feature Flags
# ============================================
ENABLE_RATE_LIMITING=true
ENABLE_ANALYTICS=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_WEBHOOK_CALLBACKS=false

# ============================================
# Reliability / Queue Settings
# ============================================
WEBHOOK_RETRY_ATTEMPTS=3
